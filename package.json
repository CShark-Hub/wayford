{
  "name": "wayford",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @wayford/io --filter @wayford/web --filter @wayford/target-app dev",
    "seed:demo": "pnpm --filter @wayford/io seed:demo",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.browser.test.ts\"",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
