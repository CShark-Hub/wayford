# Copy to .env. Never commit .env.
PORT=3000
LOG_LEVEL=info
DATABASE_URL=file:./wayford.sqlite

# LLM adapter (packages/agent/src/llm-settings.ts).
# https only; plain http is accepted for localhost (Ollama).
LLM_BASE_URL=https://openrouter.ai/api/v1
# Required: one line of printable characters. For a local Ollama any such value works.
LLM_API_KEY=

# Per role: model id, temperature and reasoning effort. The defaults below are
# the "While we build" column of the team's model ladder ("Wayford — Model
# ladder for AI testing", 2026-09-25). Uncomment a line to change it; an empty
# value keeps the default. Every model id must be priced in
# packages/agent/models.yaml. Effort: max, xhigh, high, medium, low, minimal,
# none, or `default` to send no effort (Ollama, direct OpenAI).
# LLM_EXTRACTOR_MODEL=openai/gpt-6-luna
# LLM_EXTRACTOR_TEMPERATURE=1
# LLM_EXTRACTOR_EFFORT=high
# LLM_SCOUT_MODEL=openai/gpt-6-luna
# LLM_SCOUT_TEMPERATURE=1
# LLM_SCOUT_EFFORT=max
# LLM_ACTOR_MODEL=openai/gpt-6-luna
# LLM_ACTOR_TEMPERATURE=1
# LLM_ACTOR_EFFORT=high
# LLM_ANALYST_MODEL=openai/gpt-6-luna
# LLM_ANALYST_TEMPERATURE=1
# LLM_ANALYST_EFFORT=max

# Escalation for report and pitch runs: every role stays on Luna until week 3,
# so a stray run never bills the expensive models. Week 3 puts Sol (Scout,
# Extractor) and Opus 5.5 (Analyst) here.
# LLM_SCOUT_MODEL=openai/gpt-6-luna
# LLM_EXTRACTOR_MODEL=openai/gpt-6-luna
# LLM_ANALYST_MODEL=openai/gpt-6-luna